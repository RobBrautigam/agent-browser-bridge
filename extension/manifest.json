{
  "manifest_version": 3,
  "name": "Agent Browser Bridge",
  "version": "0.2.0",
  "description": "Drive your real, logged-in browsers from any AI agent",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "activeTab",
    "debugger",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Agent Browser Bridge",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
